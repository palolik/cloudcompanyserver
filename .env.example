# MongoDB Atlas user/password + JWT signing secret (all required)
EMAILDB=
PASSDB=
JWT_SECRET=

# Company mail (cPanel on cloudcompany.cc): SMTP 465 (SSL), IMAP 993 (SSL).
# One password per mailbox; a mailbox without one is shown as unconfigured
# and refuses to send. Automatic emails go out from info@, reset codes from support@.
MAIL_HOST=cloudcompany.cc
MAIL_SMTP_PORT=465
MAIL_IMAP_PORT=993
MAIL_INFO_PASSWORD=
MAIL_SUPPORT_PASSWORD=
MAIL_CEO_PASSWORD=

# Public site origin for links in push notifications (defaults to https://cloudcompany.cc)
WEB_APP_URL=

# CC Events: API key/secret from CC Events admin > startup (Cloud Company)
CC_EVENTS_URL=
CC_EVENTS_API_KEY=
CC_EVENTS_API_SECRET=
# Secret returned once when the delivery webhook URL (<api>/events/deliver) is set in CC Events
CC_EVENTS_WEBHOOK_SECRET=
# Read-only dashboard link (/l/<token>) shown in CCAdmin > Event Analytics
CC_EVENTS_DASHBOARD_URL=
# Set to true to also send noisy read events (package views)
CC_EVENTS_TRACK_ALL_READS=

# Firebase Cloud Messaging (project cloudcompany-dbc36): service-account JSON from
# Firebase console > Project settings > Service accounts > Generate new private key.
# Path relative to the project root, or the JSON itself in FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=
